# Host-Caster server settings. Copy to .env (repo root) and fill in what you need. Everything is optional except
# PUBLIC_URL when people sign in from other devices. Used by docker compose and by `npm start` in server/.
# Full guide: docs/SELF-HOSTING.md

# ---- where people reach your server --------------------------------------------------------------------------------
# The address in the browser bar, with https in front (sign-in callbacks and cookies depend on it).
PUBLIC_URL=http://localhost:8660

# ---- sign-in ------------------------------------------------------------------------------------------------------
# Google: Google Cloud console, OAuth client of type "Web application",
#   redirect URI = PUBLIC_URL + /auth/google/callback. Adds calendar, Gmail and YouTube for the hosts.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# X: developer console, app with OAuth 2.0 (type Web App), callback = PUBLIC_URL + /auth/x/callback.
X_CLIENT_ID=
X_CLIENT_SECRET=
# Email + password accounts. Default: on when neither Google nor X is set up, off otherwise.
# ALLOW_LOCAL_ACCOUNTS=true
# Stop new accounts (people who already have one can still sign in).
# ALLOW_SIGNUPS=false
# Days a sign-in stays valid without use (each visit extends it).
# SESSION_DAYS=60

# ---- music on the server -------------------------------------------------------------------------------------------
# Docker: a folder on this machine with your music (mounted read-only). Without Docker use MUSIC_DIR instead.
# MUSIC_PATH=/srv/music
# MUSIC_DIR=/srv/music
# Scan for new and changed files when the server starts.
# LIBRARY_SCAN_ON_START=true

# ---- safety ---------------------------------------------------------------------------------------------------------
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts saved keys and tokens. Empty = generated into DATA_DIR
# on first start (keep that file with your backups; losing it means people re-enter their keys).
# SECRET_KEY=
# Addresses people type in (feeds, their own AI or voice servers) may not reach private networks by default.
# Allow every private address (fine for a home server only you use):
# ALLOW_PRIVATE_FETCH=false
# Or allow just some: CIDRs, IPs, host names or host:port, comma separated (cloud metadata stays blocked).
# FETCH_ALLOW=192.168.1.50,100.64.0.0/10
# Which proxies may set X-Forwarded-For (the visitor address used for sign-in limits). Default: proxies on this
# machine or a private network. A number = that many hops; behind a hosting platform that chains several proxies, list
# their addresses instead.
# TRUST_PROXY=loopback,linklocal,uniquelocal

# ---- running without Docker ----------------------------------------------------------------------------------------
# PORT=8660
# HOST=0.0.0.0
# DATA_DIR=./data
# APP_DIST=../app/dist
# COOKIE_SECURE=true   # default: on when PUBLIC_URL starts with https

# ---- Docker Compose only -------------------------------------------------------------------------------------------
# Which host address and port the container is published on (127.0.0.1 = only a proxy on this machine reaches it).
# HOSTCASTER_BIND=127.0.0.1
# HOSTCASTER_PORT=8660

# ---- ChatGPT plan ---------------------------------------------------------------------------------------------------
# "Use your ChatGPT plan" brains: everyone signs in with their own ChatGPT account (nothing to register here). OpenAI
# allows this for self-hosted servers; a paid or public hosted service needs OpenAI's approval first. false = off.
# CHATGPT_PLAN=true
# ChatGPT sends the sign-in answer to http://127.0.0.1:<port>/auth/callback. The server listens there during a sign-in
# (a browser on this computer then finishes by itself; other devices paste the address). In Docker on your own
# computer use CHATGPT_CALLBACK_BIND=0.0.0.0 and publish 127.0.0.1:1455:1455.
# CHATGPT_CALLBACK_PORT=1455
# CHATGPT_CALLBACK_BIND=127.0.0.1

# ---- extras ---------------------------------------------------------------------------------------------------------
# Spotify app client id, offered to the apps so people do not need their own (PKCE, no secret).
# SPOTIFY_CLIENT_ID=
# Deep link scheme of the phone apps (change it only if you build the apps with another scheme).
# APP_SCHEME=hostcaster
# How much the server logs: debug, info, warn or error. "info" logs every request path and IP address (the secret part
# of AI app connection URLs is written as /mcp/***), so keep logs private or use warn.
# LOG_LEVEL=info


# ---- provider addresses (tests and special setups only) -------------------------------------------------------------
# The real Google, X and ElevenLabs addresses are built in. The test suite points these at a fake provider.
# GOOGLE_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
# GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
# GOOGLE_REVOKE_URL=https://oauth2.googleapis.com/revoke
# GOOGLE_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo
# GOOGLE_API_BASE=https://www.googleapis.com
# X_AUTH_URL=https://x.com/i/oauth2/authorize
# X_TOKEN_URL=https://api.x.com/2/oauth2/token
# X_REVOKE_URL=https://api.x.com/2/oauth2/revoke
# X_API_BASE=https://api.x.com
# ELEVENLABS_API_BASE=https://api.elevenlabs.io
# CHATGPT_ISSUER=https://auth.openai.com
# CHATGPT_API_BASE=https://api.openai.com/v1
