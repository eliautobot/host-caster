<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Electron's V8 needs JIT under the hardened runtime -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- talk to the online server, providers and models on the home network -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- the local helper listens on 127.0.0.1 (ChatGPT sign-in callback, the app's own calls) -->
    <key>com.apple.security.network.server</key>
    <true/>
    <!-- "Talk to the host" with the microphone -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
  </dict>
</plist>
